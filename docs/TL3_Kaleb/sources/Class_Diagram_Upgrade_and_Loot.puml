@startuml Feature4_Upgrade_and_Loot
' Feature 4 only — Upgrade & Loot System
' GoF Prototype + Memento (sourcemaking). Only LootSystem is MonoBehaviour.
' Render: plantuml sources/Class_Diagram_Upgrade_and_Loot.puml
' PNG is drawn by sources/build_class_diagram.py → general_diagrams/class_diagram.png

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor #2F3E4E
    FontColor #2C3E50
}

title Class Diagram — Feature 4 Upgrade & Loot System

class MonoBehaviour <<Unity>> #E8E8E8 {
}

class LootSystem <<Caretaker>> #F3D2B5 {
    - table : LootTable
    - loadout : Loadout
    - heldMemento : ItemMemento
    + Table { get; }
    + Loadout { get; }
    + ApplyItem(item : Item, stats : PlayerStats) : void
    + RollDrop(roomType : RoomType) : Item
    + SaveState() : ItemMemento
    + RestoreState(m : ItemMemento) : void
    + Update() : void
}

class Loadout <<Originator>> #F3D2B5 {
    - items : Item[0..*]
    - consumableTimers : (string, float)[*]
    + Items { get; }
    + ConsumableTimers { get; }
    + ApplyItem(item : Item, stats : PlayerStats) : void
    + CreateMemento() : ItemMemento
    + SetMemento(m : ItemMemento) : void
}

class ItemMemento <<Memento>> {
    - equippedItemIds : string[*]
    - consumableTimers : (string, float)[*]
    - statBaseline : PlayerStats
    - schemaVersion : int = 1
    ~ CopyFrom(loadout : Loadout) : void
    ~ RestoreInto(loadout : Loadout) : void
}

abstract class Item <<Prototype>> #F3D2B5 {
    - itemId : string
    - kind : ItemKind
    + ItemId { get; set; }
    + Kind { get; set; }
    + ApplyEffect(stats : PlayerStats) : void {virtual}
    + Clone() : Item {virtual}
}

class WeaponUpgradeItem {
    - attackDelta : int
    + AttackDelta { get; set; }
    + ApplyEffect(stats : PlayerStats) : void {override}
    + Clone() : Item {override}
}

class ArmorUpgradeItem {
    - defenseDelta : int
    - maxHealthDelta : int
    + DefenseDelta { get; set; }
    + MaxHealthDelta { get; set; }
    + ApplyEffect(stats : PlayerStats) : void {override}
    + Clone() : Item {override}
}

class ConsumableItem {
    - consumableId : string
    - durationRemaining : float
    - attackDelta : int
    + ConsumableId { get; set; }
    + DurationRemaining { get; set; }
    + AttackDelta { get; set; }
    + ApplyEffect(stats : PlayerStats) : void {override}
    + Revert(stats : PlayerStats) : void
    + Clone() : Item {override}
}

class RelicItem {
    - relicId : string
    - moveSpeedDelta : float
    - critChanceDelta : int
    + RelicId { get; set; }
    + MoveSpeedDelta { get; set; }
    + CritChanceDelta { get; set; }
    + ApplyEffect(stats : PlayerStats) : void {override}
    + Clone() : Item {override}
}

class LootTable <<Prototype registry>> {
    - prototypes : Item[*]
    - dropRates : Map<RoomType, float>
    - weights : Map<RoomType, (string, int)[*]>
    + Prototypes { get; }
    + DropRates { get; }
    + RollDrop(roomType : RoomType) : Item
}

enum ItemKind {
    None
    WeaponUpgrade
    ArmorUpgrade
    Consumable
    Relic
}

MonoBehaviour <|-- LootSystem

Item <|-- WeaponUpgradeItem
Item <|-- ArmorUpgradeItem
Item <|-- ConsumableItem
Item <|-- RelicItem

LootSystem *-- LootTable
LootSystem *-- Loadout
LootSystem o-- ItemMemento : holds, never peeks
Loadout --> ItemMemento : writes / reads
Loadout o-- Item : equipped
LootTable --> Item : clones prototype
Item --> ItemKind

note bottom of Item
  **Dynamic binding**
  ApplyItem calls item.ApplyEffect(stats).
  Remove virtual / override → Item no-op;
  HUD-visible stats stop changing.
  NullItem = Kind None (not a fifth subclass).
end note

note bottom of ItemMemento
  **GoF Memento**
  Opaque lock-box. Only Loadout (Originator)
  may read or write fields. LootSystem is
  Caretaker and must not inspect state.
  Champion ItemSnapshot fields live here.
end note

note bottom of LootTable
  **GoF Prototype + Unity**
  RollDrop clones a registered Item.
  Never "new WeaponUpgradeItem()" in clients.
  Only LootSystem inherits MonoBehaviour
  (scene hook, pickup, 10 s consumable tick).
  Item / LootTable / Loadout / ItemMemento
  stay plain C# so Clone() can use new.
end note

@enduml
